# HireLens AI - Environment Configuration

# Backend Server Host & Port
HOST=127.0.0.1
PORT=8000

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Relational Database Connection (PostgreSQL or SQLite fallback)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/hirelens_db

# JWT Authentication Settings
JWT_SECRET_KEY=hirelens-ai-production-super-secret-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=4320

# Optional: Google Gemini API Key for enhanced AI rewrite suggestions
# Core application runs 100% locally with offline NLP if this key is omitted.
GEMINI_API_KEY=your_gemini_api_key_here
